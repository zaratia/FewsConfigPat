<?xml version="1.0" encoding="UTF-8"?>
<transformationModule version="1.0" xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/transformationModule.xsd">
	<variable>
		<variableId>ForecastVar</variableId>
		<timeSeriesSet>
			<moduleInstanceId>Interpolate_ECMWF</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>$internal_var$</parameterId>
			<locationId>ecmwftn</locationId>
			<timeSeriesType>external forecasting</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-10" end="10" startOverrulable="true"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>CentroidVar</variableId>
		<timeSeriesSet>
			<moduleInstanceId>InterpolateForecastNearest_template</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>$internal_var2$</parameterId>
			<locationSetId>$locationSetId$</locationSetId>
			<timeSeriesType>external forecasting</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-10" end="10" startOverrulable="true"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</variable>
	
	<transformation id="InterpolateForecastToCentroidsTemper">
		<interpolationSpatial>
			<closestDistance>				
				<inputVariable>
					<variableId>ForecastVar</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>CentroidVar</variableId>
				</outputVariable>
			</closestDistance>
		</interpolationSpatial>
	</transformation>
</transformationModule>