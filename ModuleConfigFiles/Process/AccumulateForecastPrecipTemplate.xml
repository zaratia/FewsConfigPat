<transformationModule xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/transformationModule.xsd" version="1.0">
	<!--Input-->
	<variable>
		<variableId>input_precip</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$InputModuleInstanceId$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>$InputParameterId$</parameterId>
			<locationSetId>$LocationSetId$</locationSetId>
			<timeSeriesType>$TimeSeriesType$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TimeStepHour$"/>
			<readWriteMode>read complete forecast</readWriteMode>
			<ensembleId>$EnsembleId$</ensembleId>
		</timeSeriesSet>
	</variable>
	<!--Output-->
	<variable>
		<variableId>accum_precip</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>$OutputParameterId$</parameterId>
			<locationSetId>$LocationSetId$</locationSetId>
			<timeSeriesType>$TimeSeriesType$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TimeStepHour$"/>
			<readWriteMode>read complete forecast</readWriteMode>
			<ensembleId>$EnsembleId$</ensembleId>
		</timeSeriesSet>
	</variable>
	<!--Transformations-->
	<transformation id="accum_precip_transformation">
		<accumulation>
			<sum>
				<inputVariable>
					<variableId>input_precip</variableId>
				</inputVariable>
				<ignoreMissing>true</ignoreMissing>
				<outputVariable>
					<variableId>accum_precip</variableId>
				</outputVariable>
			</sum>
		</accumulation>
	</transformation>
</transformationModule>
