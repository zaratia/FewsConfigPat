<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>	
		<general>
			<importType>NETCDF-CF_GRID</importType>
			<folder>$IMPORT_FOLDER$/NETCDF_FORECAST</folder>
			<fileNamePatternFilter>*_ecmwf.nc</fileNamePatternFilter>
			<!--fileNameObservationDateTimePattern>'3B-HHR-E.MS.MRG.3IMERG.'yyyyMMdd'-S'HHmmss'-E?'</fileNameObservationDateTimePattern-->
			<failedFolder>$IMPORT_FAILED_FOLDER$/NETCDF_FORECAST</failedFolder>
			<backupFolder>$IMPORT_BACKUP_FOLDER$/NETCDF_FORECAST</backupFolder>
			<idMapId>IdImportECMWF_OAnc</idMapId>
			<unitConversionsId>ImportUnitConversions</unitConversionsId>
			<importTimeZone>
				<timeZoneOffset>+00:00</timeZoneOffset>
			</importTimeZone>
			<expiryTime unit="day" multiplier="7"/>
		</general>
        <timeSeriesSet>
            <moduleInstanceId>Interpolate_ECMWF</moduleInstanceId>
            <valueType>grid</valueType>
            <parameterId>T.forecast</parameterId>       
            <locationId>ecmwftn</locationId>      
            <timeSeriesType>external forecasting</timeSeriesType>       
            <timeStep unit="hour" multiplier="1"/>  
            <readWriteMode>read complete forecast</readWriteMode>    
        </timeSeriesSet>
		<externUnit parameterId="P.forecast" cumulativeSum="false" unit="mm"/>
		<externUnit parameterId="T.forecast" cumulativeSum="false" unit="oC"/>
	</import>
</timeSeriesImportRun>
