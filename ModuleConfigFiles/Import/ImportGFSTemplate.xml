<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>
		<general>
			<importType>NETCDF-CF_GRID</importType>
			<serverUrl>$NoaaGfsBaseUrl$/gfs_0p25/gfs%TIME_ZERO(yyyyMMdd)%/gfs_0p25_%TIME_ZERO(HH)%z</serverUrl>
			<idMapId>IdImportGFS</idMapId>
			<unitConversionsId>ImportUnitConversions</unitConversionsId>
			<missingValue>9.999E20 </missingValue>
			<importTimeZone>
				<timeZoneName>GMT</timeZoneName>
			</importTimeZone>
			<dataFeedId>GFS.Server</dataFeedId>
		</general>
		<startTimeShift>
			<parameterId>PC.nwp</parameterId>
			<relativePeriod unit="hour" start="-3" end="0"/>
		</startTimeShift>
		<timeSeriesSet>
			<moduleInstanceId>ImportGFS</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>$ParameterId$</parameterId>
			<locationId>GFS</locationId>
			<timeSeriesType>external forecasting</timeSeriesType>
			<timeStep unit="hour" multiplier="3"/>
			<readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
		<externUnit parameterId="PC.nwp" unit="mm" cumulativeSum="true"/>
		<externUnit parameterId="TA.nwp" unit="K"/>
	</import>
</timeSeriesImportRun>
