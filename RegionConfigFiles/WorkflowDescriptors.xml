<workflowDescriptors xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflowDescriptors.xsd" version="1.0">
	<!--Import Scalar Data Workflows-->
	<workflowDescriptor id="ImportWSCDaily" name="Import Daily Hydro Station Data (WSC)" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
	<workflowDescriptor id="ImportWSCHourly" name="Import Hourly Hydro Station Data (WSC)" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
	<!-- Retrieve and Import ECCC from GeoMet WebCoverage Service -->
	<workflowDescriptor id="ImportRDPAGrids" name="Import RDPA (Regional Deterministic Precip Analysis)" forecast="false" allowApprove="false" visible="true">
		<description>Retrieve Forecast Grids from Web Coverage Service (WCS)</description>
		<cardinalTimeStep id="GMT_6hourly"/>
	</workflowDescriptor>
	<workflowDescriptor id="ImportGDPSGrids" name="Import GDPS (Global Deterministic Pred Sys)" forecast="false" allowApprove="false" visible="true">
		<description>Retrieve Forecast Grids from Web Coverage Service (WCS)</description>
		<cardinalTimeStep id="GMT_12hourly"/>
	</workflowDescriptor>
	<workflowDescriptor id="ImportREPSGrids" name="Import REPS (Regional Ensemble Pred Sys)" forecast="false" allowApprove="false" visible="true">
		<description>Retrieve Forecast Grids from Web Coverage Service (WCS)</description>
		<cardinalTimeStep id="GMT_12hourly"/>
	</workflowDescriptor>
	<!-- Retrieve and Import NOAA from Server Workflows -->
	<workflowDescriptor id="ImportGFSGrids" name="Import GFS (NOAA Global Forecast Sys)" forecast="false" allowApprove="false" visible="true">
		<description>Retrieve Forecast Grids from NOMADS server</description>
		<cardinalTimeStep timeZone="GMT" unit="hour" multiplier="6"/>
	</workflowDescriptor>

	<!--PAT-->
		<workflowDescriptor id="ImportCSVstations" name="Import station data from CSV\ and CSV_NE\" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
		<workflowDescriptor id="Export_timeseries_OA_NETCDF" name="Export station data to OA" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
		<workflowDescriptor id="OpenArchive_Import" name="Import station data from OA" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
		<workflowDescriptor id="ImportCSVcentroids" name="Import basin centroids data from CSV" visible="true" forecast="false" autoApprove="false" allowApprove="false"/>
		<workflowDescriptor id="RunGeoframeHistoric" name="Run Geoframe Historical" visible="true" forecast="true"/>
	<!--PAT-->

	<!--Processing-->
	<workflowDescriptor id="Process_Gdps" name="Process GDPS" visible="false" forecast="false" autoApprove="true" allowApprove="false"/>
	<workflowDescriptor id="Process_Reps" name="Process REPS" visible="false" forecast="false" autoApprove="true" allowApprove="false"/>
	<rootNode>
		<node name="Run Geoframe">
			<workflowId>RunGeoframeHistoric</workflowId>
		</node>
		<node name="Import PAT station data">
			<workflowId>ImportCSVstations</workflowId>
		</node>
		<node name="Export PAT station data to OpenArchive">
			<workflowId>Export_timeseries_OA_NETCDF</workflowId>
		</node>
		<node name="Import PAT station data from OpenArchive">
			<workflowId>OpenArchive_Import</workflowId>
		</node>
		<node name="Import PAT centroid data">
			<workflowId>ImportCSVcentroids</workflowId>
		</node>
		<node name="Import Station Observations">
			<workflowId>ImportWSCDaily</workflowId>
			<workflowId>ImportWSCHourly</workflowId>
		</node>
		<node name="Import Meteo Forecasts">
			<workflowId>ImportRDPAGrids</workflowId>
			<workflowId>ImportGDPSGrids</workflowId>
			<workflowId>ImportREPSGrids</workflowId>
			<workflowId>ImportGFSGrids</workflowId>
		</node>
	</rootNode>
</workflowDescriptors>
