<filters version="1.1" xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/filters.xsd">
	
	<!-- Add default filter Id -->
	<defaultFilterId>DatiMisurati</defaultFilterId>

	<!-- First Level Filters -->
	<filter id="DatiMisurati" name="Gauge data">
		<mapExtentId>Trentino</mapExtentId>
		<child foreignKey="PluviometriPAT"/>
		<child foreignKey="TermometriPAT"/>
		<child foreignKey="TermometriPAT_ne"/>
	</filter>
	<filter id="basins" name="Brenta basins">
		<mapExtentId>Trentino</mapExtentId>
		<child foreignKey="krigtemp"/>
		<child foreignKey="krigprec"/>
	</filter>
	<filter id="krigtemp" name="Kriging temperature [°C]">
		<timeSeriesSet>
			<moduleInstanceId>Import_centroids_CSV</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>T.obs</parameterId>
			<locationSetId>Centroids_Brenta_TA</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-5" end="0"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</filter>
	<filter id="krigprec" name="Kriging precipitation [mm]">
		<timeSeriesSet>
			<moduleInstanceId>Import_centroids_CSV</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>P.obs</parameterId>
			<locationSetId>Centroids_Brenta_TP</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-5" end="0"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</filter>
	<filter id="PluviometriPAT" name="Precipitation [mm]">
		<timeSeriesSet>
			<moduleInstanceId>Import_stations_CSV</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>P.obs</parameterId>
			<locationSetId>Stazioni_TP_PAT</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-5" end="0"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</filter>
	<filter id="TermometriPAT" name="Temperature [°C]">
		<timeSeriesSet>
			<moduleInstanceId>Import_stations_CSV</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>T.obs</parameterId>
			<locationSetId>Stazioni_TA_PAT</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<relativeViewPeriod unit="day" start="-5" end="0"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</filter>
	<filter id="TermometriPAT_ne" name="Temperature non equid. [°C]">
		<timeSeriesSet>
			<moduleInstanceId>Import_stations_CSV_nonequid</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>T.obs</parameterId>
			<locationSetId>Stazioni_TA_PAT</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="nonequidistant"/>
			<relativeViewPeriod unit="day" start="-5" end="0"/>
			<readWriteMode>read only</readWriteMode>
		</timeSeriesSet>
	</filter>
</filters>
