	<timeMarkersDisplayConfig>
		<timeMarkerDisplayOptions marker="systemTime">
			<color>green</color>
			<lineStyle>solid</lineStyle>
		</timeMarkerDisplayOptions>
		<timeMarkerDisplayOptions marker="timeZero">
			<color>gray</color>
			<lineStyle>dotted</lineStyle>
		</timeMarkerDisplayOptions>
		<timeMarkerDisplayOptions marker="displayTime">
			<color>red</color>
			<lineStyle>solid</lineStyle>
		</timeMarkerDisplayOptions>
		<timeMarkerDisplayOptions marker="threshold">
			<color>orange</color>
			<lineStyle>dashed</lineStyle>
		</timeMarkerDisplayOptions>
	</timeMarkersDisplayConfig>
	<parametersDisplayConfig>
		<defaults>
			<preferredColor>blue</preferredColor>
			<lineStyle>solid;thick</lineStyle>
		</defaults>
		<parameterDisplayOptions id="QR.obs">
			<preferredColor>black</preferredColor>
			<lineStyle>dashdot</lineStyle>
			<markerStyle>x</markerStyle>
			<markerSize>2</markerSize>
		</parameterDisplayOptions>
		<parameterDisplayOptions id="PC.obs">
			<preferredColor>blue</preferredColor>
			<lineStyle>bar</lineStyle>
			<min>0</min>
			<max>2</max>
			<inverted>true</inverted>
		</parameterDisplayOptions>
		<parameterDisplayOptions id="PC.obs.acc">
			<preferredColor>black</preferredColor>
			<lineStyle>solid</lineStyle>
			<min>0</min>
		</parameterDisplayOptions>
		<parameterDisplayOptions id="PC.nwp">
			<preferredColor>light blue</preferredColor>
			<lineStyle>bar</lineStyle>
			<min>0</min>
			<max>2</max>
			<inverted>true</inverted>
		</parameterDisplayOptions>
		<parameterDisplayOptions id="PC.cpa">
			<preferredColor>blue3</preferredColor>
			<lineStyle>bar</lineStyle>
			<min>0</min>
			<max>2</max>
			<inverted>true</inverted>
		</parameterDisplayOptions>
