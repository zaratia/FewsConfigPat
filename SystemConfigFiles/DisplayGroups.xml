	<!--Display Groups -->
	<displayGroup id="ImportWSCHourly" name="WSC Stations Hourly">
		<nodeId>ImportWSCHourly</nodeId>
		<singleLocationDisplays>
			<locationSetId>DisplayMeteoStations</locationSetId>
			<plotId>WSCHourlyTemplate</plotId>
		</singleLocationDisplays>
	</displayGroup>
	<displayGroup name="RDPA">
