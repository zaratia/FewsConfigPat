<gridDisplay xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews
http://fews.wldelft.nl/schemas/version1.0/gridDisplay.xsd">
	<title>Spatial Display</title>
	<defaults>
		<plotGroupId>HydrologicalStations</plotGroupId>
		<plotGroupId>MeteoStations</plotGroupId>
		<plotGroupId>MeteoForecasts</plotGroupId>
		<plotGroupId>MeteoForecastsProcessed</plotGroupId>
		<plotGroupId>WFlowModel</plotGroupId>
		<geoMap>
			<geoDatum>WGS 1984</geoDatum>
			<projection>web_mercator</projection>
			<defaultExtent id="Trentino">
				<left>9</left>
				<right>12</right>
				<top>47</top>
				<bottom>44</bottom>
			</defaultExtent>
			<extraExtent id="Northwest Territories">
				<left>-120</left>
				<right>-100</right>
				<top>71</top>
				<bottom>57</bottom>
			</extraExtent>
			<extraExtent id="Canada">
				<left>-152</left>
				<right>-47</right>
				<top>40</top>
				<bottom>75</bottom>
			</extraExtent>
			<extraExtent id="World">
				<left>-180</left>
				<right>180</right>
				<top>90</top>
				<bottom>-70</bottom>
			</extraExtent>
			<scaleBarVisible>true</scaleBarVisible>
			<northArrowVisible>true</northArrowVisible>
			<labelsVisible>true</labelsVisible>
			<backgroundColor>white</backgroundColor>
			<openStreetMapLayer id="Open Street Map">
				<url>http://tile.openstreetmap.org</url>
				<visible>true</visible>
				<cacheDir>$MapLayersCacheFolder$/OSM</cacheDir>
			</openStreetMapLayer>
			<layer id="Satellite">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://h%RIGHT(QUAD_KEY,1)%.ortho.tiles.virtualearth.net/tiles/h%QUAD_KEY%.jpeg?g=1"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/Satellite_Cache"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="17"/>
					<int key="topZoomLevel" value="19"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<layer id="Topografie" name="ArcGIS World Topo Map">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/%ZOOM%/%ROW%/%COLUMN%"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/Esri_topo"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="19"/>
					<int key="topZoomLevel" value="21"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<layer id="Canvas" name="ArcGIS Canvas World LightGray Base">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://server.arcgisonline.com/arcgis/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/%ZOOM%/%ROW%/%COLUMN%"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/Esri_Canvas_World_Light_Gray_Base"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="19"/>
					<int key="topZoomLevel" value="21"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<layer id="World" name="ArcGIS World Satellite Map">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://server.arcgisonline.com/arcgis/rest/services/World_Imagery/MapServer/tile/%ZOOM%/%ROW%/%COLUMN%"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/World_Imagery"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="19"/>
					<int key="topZoomLevel" value="21"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<layer id="NatGeo_World_Map" name="ArcGIS Physical Map">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://server.arcgisonline.com/ArcGIS/rest/services/NatGeo_World_Map/MapServer/tile/%ZOOM%/%ROW%/%COLUMN%"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/NatGeo_World_Map"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="14"/>
					<int key="topZoomLevel" value="18"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<layer id="World_Shaded_Relief" name="ArcGIS Shaded Relief">
				<className>nl.wldelft.libx.openmap.GenericTileServerLayer</className>
				<visible>false</visible>
				<properties>
					<string key="tileUrlPattern" value="http://server.arcgisonline.com/ArcGIS/rest/services/World_Shaded_Relief/MapServer/tile/%ZOOM%/%ROW%/%COLUMN%"/>
					<string key="cacheDir" value="$MapLayersCacheFolder$/World_Shaded_Relief"/>
					<int key="minZoomLevel" value="1"/>
					<int key="maxZoomLevel" value="14"/>
					<int key="topZoomLevel" value="21"/>
					<int key="tileSize" value="256"/>
				</properties>
			</layer>
			<esriShapeLayer id="World Countries">
				<description>World</description>
				<file>WorldCountries.shp</file>
				<geoDatum>WGS 1984</geoDatum>
				<visible>true</visible>
				<toolTip>%CNTRY_NAME%</toolTip>
				<lineColor>black</lineColor>
				<fillRgbColor>FFFFFF</fillRgbColor>
				<opaquenessPercentage>20</opaquenessPercentage>
			</esriShapeLayer>
		</geoMap>
		<timeDisplayLabels>bottomRight</timeDisplayLabels>
	</defaults>
	<defaults>
		<commentPositioning>topLeft</commentPositioning>
	</defaults>
	<gridPlotGroup id="HydrologicalStations" name="Hydrological Stations (WSC)">
		<gridPlot id="RecentObservedDischarge" name="Recent Discharge at Local Stations [m³/s]">
			<timeSeriesSet>
				<moduleInstanceId>ImportWSC</moduleInstanceId>
				<valueType>scalar</valueType>
				<parameterId>QR.obs</parameterId>
				<locationSetId>DisplayHydroStations</locationSetId>
				<timeSeriesType>external historical</timeSeriesType>
				<timeStep unit="minute" multiplier="5"/>
				<relativeViewPeriod unit="day" start="-15" end="0"/>
				<readWriteMode>add originals</readWriteMode>
			</timeSeriesSet>
			<showThumbnailsPanel>false</showThumbnailsPanel>
			<classBreaksId>Class.Discharge</classBreaksId>
		</gridPlot>
	</gridPlotGroup>
	<gridPlotGroup id="MeteoForecasts" name="Meteo Forecasts and Analysis">
		<gridPlotGroup id="RDPA" name="Regional Deterministic Precip Analysis (RDPA)">
			<gridPlot id="RDPAPrecipitation" name="Precipitation [mm]">
				<timeSeriesSet>
					<moduleInstanceId>ImportRDPA</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>PC.sim</parameterId>
					<locationId>RDPA</locationId>
					<timeSeriesType>external historical</timeSeriesType>
					<timeStep unit="hour" multiplier="6"/>
					<relativeViewPeriod unit="day" start="-10" end="0"/>
					<readWriteMode>read only</readWriteMode>
				</timeSeriesSet>
				<showThumbnailsPanel>false</showThumbnailsPanel>
				<numberOfRecentForecasts>3</numberOfRecentForecasts>
				<movieFrameDurationMillis>200</movieFrameDurationMillis>
				<classBreaksId>Class.Precipitation</classBreaksId>
			</gridPlot>
		</gridPlotGroup>
		<gridPlotGroup id="GDPS" name="Global Deterministic Pred Sys (GDPS) Forecast">
			<gridPlot id="GDPSPrecipitation " name="Precipitation [mm]">
				<timeSeriesSet>
					<moduleInstanceId>ImportGDPS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>PC.nwp</parameterId>
					<locationId>GDPS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>3</numberOfRecentForecasts>
				<movieFrameDurationMillis>200</movieFrameDurationMillis>
				<classBreaksId>Class.Precipitation</classBreaksId>
			</gridPlot>
			<gridPlot id="GDPSTemperature " name="Temperature [°C]">
				<timeSeriesSet>
					<moduleInstanceId>ImportGDPS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>TA.nwp</parameterId>
					<locationId>GDPS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>4</numberOfRecentForecasts>
				<classBreaksId>Class.Temperature</classBreaksId>
			</gridPlot>
		</gridPlotGroup>
		<gridPlotGroup id="REPS" name="Regional Ensemble Pred Sys (REPS) Forecast">
			<gridPlot id="REPSPrecipitation " name="Precipitation [mm]">
				<timeSeriesSet>
					<moduleInstanceId>ImportREPS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>PC.nwp</parameterId>
					<locationId>REPS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
					<ensembleId>REPS</ensembleId>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>3</numberOfRecentForecasts>
				<movieFrameDurationMillis>200</movieFrameDurationMillis>
				<classBreaksId>Class.Precipitation</classBreaksId>
			</gridPlot>
			<gridPlot id="REPSTemperature " name="Temperature [°C]">
				<timeSeriesSet>
					<moduleInstanceId>ImportREPS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>TA.nwp</parameterId>
					<locationId>REPS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
					<ensembleId>REPS</ensembleId>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>4</numberOfRecentForecasts>
				<classBreaksId>Class.Temperature</classBreaksId>
			</gridPlot>
		</gridPlotGroup>
		<gridPlotGroup id="GFS" name="NOAA Global Forecast System (GFS) Forecast">
			<gridPlot id="GFSPrecipitation " name="Precipitation [mm]">
				<timeSeriesSet>
					<moduleInstanceId>ImportGFS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>PC.nwp</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>3</numberOfRecentForecasts>
				<movieFrameDurationMillis>200</movieFrameDurationMillis>
				<classBreaksId>Class.Precipitation</classBreaksId>
			</gridPlot>
			<gridPlot id="GFSTemperature " name="Temperature [°C]">
				<timeSeriesSet>
					<moduleInstanceId>ImportGFS</moduleInstanceId>
					<valueType>grid</valueType>
					<parameterId>TA.nwp</parameterId>
					<locationId>GFS</locationId>
					<timeSeriesType>external forecasting</timeSeriesType>
					<timeStep unit="hour" multiplier="3"/>
					<readWriteMode>read complete forecast</readWriteMode>
				</timeSeriesSet>
				<showThumbnailsPanel>true</showThumbnailsPanel>
				<numberOfRecentForecasts>4</numberOfRecentForecasts>
				<classBreaksId>Class.Temperature</classBreaksId>
			</gridPlot>
			<gridPlot id="GFSWind" name="Wind speed [m/s]">
				<dataLayer>
					<arrowColor>white</arrowColor>
					<arrowSymbol>flow</arrowSymbol>
					<multipleArrowsPerValue>false</multipleArrowsPerValue>
					<uTimeSeriesSet>
						<moduleInstanceId>ImportGFS</moduleInstanceId>
						<valueType>grid</valueType>
						<parameterId>Wind.u.nwp</parameterId>
						<locationId>GFS</locationId>
						<timeSeriesType>external forecasting</timeSeriesType>
						<timeStep multiplier="3" unit="hour"/>
						<readWriteMode>read complete forecast</readWriteMode>
					</uTimeSeriesSet>
					<vTimeSeriesSet>
						<moduleInstanceId>ImportGFS</moduleInstanceId>
						<valueType>grid</valueType>
						<parameterId>Wind.v.nwp</parameterId>
						<locationId>GFS</locationId>
						<timeSeriesType>external forecasting</timeSeriesType>
						<timeStep multiplier="3" unit="hour"/>
						<readWriteMode>read complete forecast</readWriteMode>
					</vTimeSeriesSet>
					<uvAmplitudeParameterId>Wind.speed.nwp</uvAmplitudeParameterId>
					<uvDirectionParameterId>Wind.dir.nwp</uvDirectionParameterId>
				</dataLayer>
				<movieFrameDurationMillis>300</movieFrameDurationMillis>
				<hideLastValueCheckBox>true</hideLastValueCheckBox>
				<barLegend>
					<position>right</position>
					<width>50</width>
					<length>400</length>
					<labelsInside>false</labelsInside>
				</barLegend>
				<classBreaksId>Class.Wind.Speed</classBreaksId>
			</gridPlot>
		</gridPlotGroup>
	</gridPlotGroup>
</gridDisplay>
