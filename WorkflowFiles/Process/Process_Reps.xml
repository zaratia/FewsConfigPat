<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
<!-- Preprocess Precipitation-->
	<activity>
		<properties>
			<string key="InputModuleInstanceId" value="ImportREPS"/>
			<string key="ParameterId" value="PC.nwp"/>
			<string key="TimeSeriesType" value="external forecasting"/>
			<string key="TimeStepHour" value="3"/>
			<string key="InputGridId" value="REPS"/>
			<string key="StationLocationSetId" value="DisplayMeteoStations"/>
			<string key="EnsembleId" value="REPS"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ProcessReps</moduleInstanceId>
		<moduleConfigFileName>PreprocessAccumulatedParametersNWPTemplate</moduleConfigFileName>
	</activity>
	<!-- Accumulate Precipitation-->
		<activity>
		<properties>
			<string key="LocationSetId" value="DisplayMeteoStations"/>
			<string key="InputModuleInstanceId" value="ProcessReps"/>
			<string key="InputParameterId" value="PC.nwp"/>
			<string key="OutputParameterId" value="PC.nwp.acc"/>
			<string key="TimeStepHour" value="3"/>
			<string key="TimeSeriesType" value="external forecasting"/>
			<string key="EnsembleId" value="REPS"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ProcessReps</moduleInstanceId>
		<moduleConfigFileName>AccumulateForecastPrecipTemplate</moduleConfigFileName>
	</activity>
	<!-- Preprocess Temperature-->
	<activity>
		<properties>
			<string key="InputModuleInstanceId" value="ImportREPS"/>
			<string key="ParameterId" value="TA.nwp"/>
			<string key="TimeSeriesType" value="external forecasting"/>
			<string key="TimeStepHour" value="3"/>
			<string key="InputGridId" value="REPS"/>
			<string key="StationLocationSetId" value="DisplayMeteoStations"/>
			<string key="EnsembleId" value="REPS"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ProcessReps</moduleInstanceId>
		<moduleConfigFileName>PreprocessInstantaneousParametersNWPTemplate</moduleConfigFileName>
	</activity>
		<!-- Ensemble Statistics Precipitation-->
	<activity>
		<properties>
			<string key="LocationSetId" value="DisplayMeteoStations"/>
			<string key="InputModuleInstanceId" value="ProcessReps"/>
			<string key="ParameterId" value="PC.nwp.acc"/>
			<string key="TimeSeriesType" value="external forecasting"/>
			<string key="TimeStepHour" value="3"/>
			<string key="EnsembleId" value="REPS"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ProcessReps</moduleInstanceId>
		<moduleConfigFileName>CalculateEnsembleStatisticsTemplate</moduleConfigFileName>
	</activity>
	<!--Ensemble Statistics Temperature-->
	<activity>
		<properties>
			<string key="LocationSetId" value="DisplayMeteoStations"/>
			<string key="InputModuleInstanceId" value="ProcessReps"/>
			<string key="ParameterId" value="TA.nwp"/>
			<string key="TimeSeriesType" value="external forecasting"/>
			<string key="TimeStepHour" value="3"/>
			<string key="EnsembleId" value="REPS"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ProcessReps</moduleInstanceId>
		<moduleConfigFileName>CalculateEnsembleStatisticsTemplate</moduleConfigFileName>
	</activity>
</workflow>
