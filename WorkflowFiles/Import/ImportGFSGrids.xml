<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!-- Retrieve SREF NWP grids from NOAA -->
	<activity>
		<properties>
			<string key="ParameterId" value="PC.nwp"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ImportGFS</moduleInstanceId>
		<moduleConfigFileName>ImportGFSTemplate</moduleConfigFileName>
	</activity>
	<activity>
		<properties>
			<string key="ParameterId" value="TA.nwp"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ImportGFS</moduleInstanceId>
		<moduleConfigFileName>ImportGFSTemplate</moduleConfigFileName>
	</activity>
	<activity>
		<properties>
			<string key="ParameterId" value="Wind.u.nwp"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ImportGFS</moduleInstanceId>
		<moduleConfigFileName>ImportGFSTemplate</moduleConfigFileName>
	</activity>
	<activity>
		<properties>
			<string key="ParameterId" value="Wind.v.nwp"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ImportGFS</moduleInstanceId>
		<moduleConfigFileName>ImportGFSTemplate</moduleConfigFileName>
	</activity>
</workflow>
